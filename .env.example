# DevFlow Configuration

# Server Port (Default: 1451)
PORT=1451

# Host network interface (Default: 0.0.0.0 to accept connections inside Docker)
HOST=0.0.0.0

# Public URL of your DevFlow instance (Used for email password reset links)
# Example: https://devflow.yourdomain.com or http://localhost:1451
APP_URL=https://devflow.yourdomain.com

# Storage directory for SQLite database (Coolify Volume mount: /data)
DATA_DIR=/data

# Application environment (production / development)
APP_ENV=production

# JWT secret key for signing auth tokens (minimum 32 random characters)
# If left blank, DevFlow will auto-generate and persist a secure 256-bit key in /data/.jwt_secret
JWT_SECRET=generate_your_secure_random_jwt_secret_key_here

# Enable or disable public user registration (true / false)
ENABLE_REGISTRATION=true

# Rate Limiter Requests Per Second per IP
RATE_LIMIT_RPS=50

# ------------------------------------------------------------------------------
# Email Delivery Service (Option 1: Resend API — Recommended)
# ------------------------------------------------------------------------------
# Get your API key at https://resend.com
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM=DevFlow <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# Email Delivery Service (Option 2: Custom SMTP — Gmail, Yandex, Mailgun, etc.)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=DevFlow <your_email@gmail.com>
# SMTP_INSECURE_SKIP_VERIFY=false

# Note: If neither RESEND_API_KEY nor SMTP_HOST is provided, password reset links
# will be printed directly to server logs (Console Mailer) so you never get locked out.
