# DevFlow Configuration

# Server Port (Default: 1451)
PORT=1451

# Storage directory for SQLite database (Coolify Volume mount: /data)
DATA_DIR=/data

# JWT secret key for signing auth tokens (minimum 32 random characters)
JWT_SECRET=generate_your_secure_random_jwt_secret_key_here

# Enable or disable public user registration (true / false)
ENABLE_REGISTRATION=true

# Rate Limiter RPS per IP
RATE_LIMIT_RPS=50
